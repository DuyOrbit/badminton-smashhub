<title>Đặc Tả Usecase Mẫu Chuẩn - BadmintonConnect</title>
<style>
    body { font-family: 'Times New Roman', Times, serif; font-size: 12pt; line-height: 1.4; color: #000; }
    h1 { text-align: center; font-size: 16pt; font-weight: bold; margin-bottom: 20px; text-transform: uppercase; color: #17365d; }
    h2 { font-size: 13pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px; color: #2e74b5; text-transform: uppercase; border-bottom: 1px solid #2e74b5; padding-bottom: 3px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 25px; page-break-inside: avoid; }
